# ============ 基础 ============
SITE_NAME=AI 开发者社区
SITE_DESCRIPTION=企业 AI 原生开发者社区
# 公网部署域名（MCP 与邮件链接使用）
PUBLIC_BASE_URL=http://localhost
# 部署内网 SSO 适配器时，填写精确域名（逗号分隔）；不关闭全局 SSRF 防护。
SSO_ALLOWED_HOSTS=
# 可选：仅 SSO 登录用户退出时通过浏览器跳转此 HTTPS 地址。
SSO_LOGOUT_URL=

# ============ 数据库 / Redis ============
# 本地开发（Docker compose 启动 db/redis 后）
DATABASE_URL=postgresql+psycopg://community:community@localhost:5432/community
REDIS_URL=redis://localhost:6379/0

# ============ 安全 ============
# 生产必须更换：openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=720
JWT_REFRESH_EXPIRE_DAYS=30
# AES-256 密钥（32 字节 hex），用于加密模型 API Key：openssl rand -hex 32
AES_KEY=change-me-32-bytes-hex-0123456789abcdef0123456789abcdef
# MCP 服务访问令牌（豆包工作配置 MCP 时填 Authorization: Bearer <此值>）
MCP_API_KEY=change-me-mcp-token
# 邀请码有效期（天）
INVITE_EXPIRE_DAYS=7

# 初始超管（可选：配置后首次启动自动创建；不配置则首个注册用户自动成为超管）
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=管理员

# ============ 默认模型（OpenAI 兼容） ============
# 首次启动会写入 model_configs 表，之后可在后台修改
DEFAULT_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DEFAULT_LLM_API_KEY=your-ark-api-key
DEFAULT_LLM_CHAT_MODEL=doubao-seed-1-6-250615
DEFAULT_EMBEDDING_MODEL=doubao-embedding-large
DEFAULT_EMBEDDING_DIM=2048

# ============ 邮件（可选，未配置则仅站内信） ============
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ============ 上传目录 ============
UPLOAD_DIR=./uploads

# ============ 检索后端（三选一，默认 numpy 零依赖） ============
# numpy   - 向量存 JSONB + 应用层余弦（默认，开箱即用）
# pgvector- PostgreSQL vector 扩展（需数据库已装扩展）
# weaviate- 独立 Weaviate 向量库（向量由应用生成，vectorizer 保持 none）
VECTOR_BACKEND=numpy
# 以下为 weaviate 时的连接信息
WEAVIATE_HOST=localhost
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051
WEAVIATE_COLLECTION=AinaDev
